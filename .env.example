# Copie este arquivo para .env e ajuste os valores.
# cp .env.example .env

# ---------------------------------------------------------------- destino
# local = grava em ./data/datalake (nao usa AWS, ideal para testar)
# s3    = grava no Amazon S3
DATALAKE_TARGET=local

# Nome do bucket S3 (precisa ser unico no mundo todo)
S3_BUCKET=meu-datalake-mackenzie
AWS_REGION=us-east-1

# --------------------------------------------------------------- particao
# Data usada na particao Hive (ingest_date=YYYY-MM-DD).
# Se ficar vazio, o pipeline usa a data de hoje.
# INGEST_DATE=2026-09-13

# ------------------------------------------------- volume da massa gerada
N_CLIENTES=200
N_PRODUTOS=60
N_PEDIDOS=2000
TAXA_ANOMALIAS=0.12
SEED=42

# ----------------------------------------------------------------- athena
ATHENA_DATABASE=datalake_mackenzie
ATHENA_WORKGROUP=primary
